---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Github, Reddit, Youtube, Bluesky, X , Ycombinator } from 'simple-icons-astro';
---

<BaseLayout title="About">
  <div class="page">
    <h1>About</h1>
    <p>Hi, I am NSPG911, but in the coding world, I go by NSPC911.</p>
    <p>I'm a 17 year old that is currently studying in a Junior College.</p>
    <p>I have been living in Singapore for almost my entire life!</p>
    <h3>Where can you find me?</h3>
    <table>
      <tr style="display: none;">
        <th></th>
        <th></th>
        <th></th>
      </tr>
      <tr>
        <td data-svg="github"><a href="https://github.com/NSPC911"><Github/> GitHub</a></td>
        <td data-svg="reddit"><a href="https://reddit.com/u/NotSoProGamerR"><Reddit/> Reddit</a></td>
        <td data-svg="youtube"><a href="https://youtube.com/@NSPG911"><Youtube/> Youtube</a></td>
      </tr>
      <tr>
        <td data-svg="bluesky"><a href="https://bsky.app/profile/did:plc:mzr5ka3kgplcb7buvrde36oe"><Bluesky/> Bluesky</a></td>
        <td data-svg="xtwitter"><a href="https://x.com/Nspg9"><X/> X/Twitter</a></td>
        <td data-svg="hackernews"><a href="https://news.ycombinator.com/user?id=NSPG911"><Ycombinator/> Hacker News</a></td>
      </tr>
    </table>
  </div>
</BaseLayout>
<style>
table {
  width: 100%;
  &:has(td:hover) td:not(:hover) {
    width: 30%
  }
}
td {
  text-align: center;
  transform: translate(0, -4px);
  transition: all 0.25s ease;
  width: 33%;
  padding: 0;
  transition-delay: 0.125s;
  svg {
    transform: translate(0, 6px);
    transition: transform 0.3s ease;
  }
  a {
    text-decoration: none;
    display: block;
    width: 100%;
    height: 100%;
    padding: 20px 0;
  }
  &:hover {
    transform: translate(0, -4px) scale(1.1);
    font-size: 1.2em;
    width: 40%;
    transition-delay: 0s;
    svg {
      transform: translate(0, 6px) scale(1.2);
    }
  }
  &:not(:hover) svg {
    fill: var(--accent) !important;
    filter:
      drop-shadow(0px 0px 0px var(--accent))
      drop-shadow(0px 0px 0px var(--accent))
      drop-shadow(0px 0px 0px var(--accent))
      drop-shadow(0px 0px 0px var(--accent)) !important;
  }
}
td[data-svg="github"] svg {
  fill: black;
}
td[data-svg="reddit"] svg {
  fill: #ff4500;
}
td[data-svg="youtube"] svg {
  fill: #ff0033;
}
td[data-svg="bluesky"] svg {
  fill: #33a5ff;
}
td[data-svg="xtwitter"] svg {
  fill: black;
}
td[data-svg="hackernews"] svg {
  fill: #cc5200;
}
tr {
  height: 75px
}
</style>
